TELEGRAM_BOT_TOKEN=123456789:replace_me
BOT_USERNAME=
DATABASE_PATH=data/reminders.db
DEFAULT_TIMEZONE=Asia/Taipei
POLL_TIMEOUT_SECONDS=25
SCHEDULER_INTERVAL_SECONDS=10
DRAFT_TTL_MINUTES=10
LOG_LEVEL=INFO
# Optional: generate with `uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# Keep this stable and backed up separately; changing it makes saved API keys unreadable.
AI_ENCRYPTION_KEY=

# Optional: enable the admin Compose profile with Telegram OIDC and these settings.
ADMIN_DATABASE_PATH=data/admin/access.db
ADMIN_TELEGRAM_IDS=
ADMIN_TELEGRAM_CLIENT_ID=
ADMIN_TELEGRAM_CLIENT_SECRET=
ADMIN_TELEGRAM_REDIRECT_URI=
ADMIN_SESSION_SECRET=
